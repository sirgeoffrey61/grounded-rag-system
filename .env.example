# =============================================================================
# Grounded RAG API — environment configuration
# Copy to .env and adjust for local / Docker / cloud deploy.
# =============================================================================

# --- Server ---
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
RAG_LOG_LEVEL=INFO
RAG_DEBUG=false

# --- Vector store ---
RAG_CHROMA_DIR=./chroma_db
RAG_CHUNKS_PATH=./processed_chunks.json
RAG_COLLECTION_NAME=quality_articles

# --- Embedding / reranker models ---
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM (Groq — default for API and Docker) ---
GROQ_API_KEY=
RAG_LLM_PROVIDER=groq
RAG_MODEL_NAME=llama-3.1-8b-instant
RAG_LLM_TIMEOUT_SECONDS=60

# --- Optional local Ollama (CLI: --use-ollama) ---
RAG_OLLAMA_MODEL=mistral
RAG_OLLAMA_BASE_URL=http://localhost:11434
