# =============================================================================
# Production / cloud — Grounded RAG API (Groq)
# Set these in Render, Railway, or Docker secrets. Do NOT commit real keys.
# =============================================================================

# --- LLM (Groq OpenAI-compatible) ---
GROQ_API_KEY=gsk_your_key_here
RAG_LLM_PROVIDER=groq
RAG_MODEL_NAME=llama-3.1-8b-instant
RAG_LLM_TIMEOUT_SECONDS=60

# --- Server ---
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
RAG_LOG_LEVEL=INFO
RAG_DEBUG=false

# --- Vector store (Docker / Render disk mount) ---
RAG_CHROMA_DIR=/app/chroma_db
RAG_CHUNKS_PATH=/app/processed_chunks.json
RAG_COLLECTION_NAME=quality_articles

# --- Models ---
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Streamlit Cloud (frontend only) ---
# RAG_API_URL=https://your-grounded-rag-api.onrender.com
